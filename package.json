{
  "name": "changelogithub",
  "type": "module",
  "version": "15.0.4",
  "packageManager": "pnpm@11.17.0",
  "description": "Generate changelog for GitHub.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu-collective/changelogithub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu-collective/changelogithub.git"
  },
  "bugs": "https://github.com/antfu-collective/changelogithub/issues",
  "keywords": [
    "github",
    "release",
    "releases",
    "conventional",
    "changelog",
    "log"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "changelogithub": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "start": "pnpm run build && node dist/cli.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "c12": "^3.3.4",
    "cac": "^7.0.0",
    "changelogen": "0.5.7",
    "convert-gitmoji": "^0.1.5",
    "ofetch": "^1.5.1",
    "tinyexec": "^1.2.4",
    "tinyglobby": "^0.2.17",
    "verkit": "^0.3.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@antfu/ni": "^30.3.0",
    "@antfu/utils": "^9.3.0",
    "@types/node": "^26.1.2",
    "bumpp": "^12.0.0",
    "eslint": "^10.8.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "inlinedDependencies": {
    "@antfu/utils": "9.3.0"
  }
}
